{
  "name": "@queekai/client-sdk",
  "version": "0.4.0",
  "private": false,
  "description": "Official Queek Storefront API client: customer sign-in, self-renewing sessions, retries, idempotency keys and pagination.",
  "keywords": [
    "queek",
    "storefront",
    "commerce",
    "api-client",
    "sdk"
  ],
  "author": "Queekx Technology LTD",
  "license": "MIT",
  "homepage": "https://docs.usequeek.com/docs/storefront",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ichie-benjamin/queek-client-sdk.git"
  },
  "bugs": {
    "email": "developers@usequeek.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run lint && npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
